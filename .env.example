# TypeSafe API base URL.
TYPESAFE_BASE_URL=http://localhost:11434 # Local Ollama default URL

# API key. Can be set to anything for local Ollama.
TYPESAFE_API_KEY=ollama

# Default model used when one isn't specified per request. Uses Clef-Flash:9b; install with `ollama pull clef-flash:9b`.
TYPESAFE_DEFAULT_MODEL=clef-flash:9b
